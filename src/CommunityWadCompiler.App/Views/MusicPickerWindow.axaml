<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CommunityWadCompiler.App.ViewModels"
        x:Class="CommunityWadCompiler.App.Views.MusicPickerWindow"
        Title="Seleccionar música"
        Width="520" Height="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <DockPanel Margin="12">

    <TextBlock DockPanel.Dock="Top"
               Text="Elegí la música del slot o cargá un archivo externo (MIDI/MOD/IT)."
               TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="Cargar archivo externo..." Click="OnPickExternal" MinWidth="160"/>
      <Button Content="Aceptar" IsDefault="True" Click="OnAccept" MinWidth="90"/>
      <Button Content="Cancelar" IsCancel="True" Click="OnCancel" MinWidth="90"/>
    </StackPanel>

    <ListBox x:Name="MusicList"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</Window>