<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CommunityWadCompiler.App.ViewModels"
        x:Class="CommunityWadCompiler.App.Views.MainWindow"
        Title="Community Wad Compiler"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="Archivo">
        <MenuItem Header="Nuevo proyecto" Click="OnNewProject"/>
        <Separator/>
        <MenuItem Header="Abrir proyecto..." Click="OnOpenProject"/>
        <MenuItem Header="Guardar proyecto" Click="OnSaveProject"/>
        <MenuItem Header="Guardar proyecto como..." Click="OnSaveProjectAs"/>
        <Separator/>
        <MenuItem Header="Configuración del proyecto..." Click="OnProjectSettings"/>
        <Separator/>
        <MenuItem Header="Salir" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="Ayuda">
        <MenuItem Header="Acerca de..." Click="OnAbout"/>
      </MenuItem>
    </Menu>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*" Margin="8,4,8,8">
      <ProgressBar Grid.Column="0" Width="260" Height="18" IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
      <Button Grid.Column="1" HorizontalAlignment="Right" Content="Compilar"
              IsDefault="True" Click="OnCompile" MinWidth="120" Margin="8,0,0,0"/>
    </Grid>

    <Grid Margin="8" RowDefinitions="*,Auto,*" ColumnDefinitions="*,2*">

      <!-- Left: input WADs + resource WADs -->
      <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="*,*" Margin="0,0,8,8">

        <DockPanel Grid.Row="0">
          <TextBlock DockPanel.Dock="Top" Text="WADs aportados (mapas)" FontWeight="Bold" Margin="0,0,0,4"/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
            <Button Content="Agregar WADs..." Click="OnAddWads"/>
            <Button Content="Quitar" Click="OnRemoveWad"/>
            <Button Content="Subir" Click="OnMoveUp"/>
            <Button Content="Bajar" Click="OnMoveDown"/>
          </StackPanel>
          <ListBox ItemsSource="{Binding InputWads}"
                   SelectedItem="{Binding SelectedWad, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
          <TextBlock DockPanel.Dock="Top" Text="Recursos de texturas / flats (configuración de proyecto)" FontWeight="Bold" Margin="0,0,0,4"/>
          <TextBlock DockPanel.Dock="Top" Text="Administrados en Archivo → Configuración del proyecto..." Foreground="Gray" Margin="0,0,0,4"/>
          <ListBox ItemsSource="{Binding ResourceWads}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

      </Grid>

      <!-- Right: maps / slots -->
      <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
        <TextBlock DockPanel.Dock="Top" Text="{Binding MapsHeader}"
                   FontWeight="Bold" Margin="0,0,0,4"/>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="90,140,100,170,100,160,130,150" Margin="0,0,0,2">
          <TextBlock Grid.Column="0" Text="Slot" FontWeight="Bold"/>
          <TextBlock Grid.Column="1" Text="WAD" FontWeight="Bold"/>
          <TextBlock Grid.Column="2" Text="Mapa original" FontWeight="Bold"/>
          <TextBlock Grid.Column="3" Text="Nombre del mapa" FontWeight="Bold"/>
          <TextBlock Grid.Column="4" Text="Estado" FontWeight="Bold"/>
          <TextBlock Grid.Column="5" Text="Última modificación" FontWeight="Bold"/>
          <TextBlock Grid.Column="6" Text="Música" FontWeight="Bold"/>
          <TextBlock Grid.Column="7" Text="Autor" FontWeight="Bold"/>
        </Grid>
        <Border BorderBrush="#808080" BorderThickness="1" CornerRadius="3">
          <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SlotRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="90,140,100,170,100,160,130,150" Margin="2,3">
                    <TextBox Grid.Column="0" Text="{Binding SlotName, Mode=TwoWay}"
                             MinWidth="60" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding WadFileName}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding OriginalName}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="3" Text="{Binding LevelName, Mode=TwoWay}"
                             MinWidth="110" VerticalContentAlignment="Center"/>
                    <ComboBox Grid.Column="4"
                              ItemsSource="{x:Static vm:SlotRowViewModel.StatusOptions}"
                              SelectedItem="{Binding Status, Mode=TwoWay}"
                              VerticalAlignment="Center" MinWidth="80"
                              MaxDropDownHeight="220"/>
                    <TextBlock Grid.Column="5" Text="{Binding LastModified}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox Grid.Column="6"
                              ItemsSource="{Binding MusicOptions}"
                              SelectedItem="{Binding MusicName, Mode=TwoWay}"
                              VerticalAlignment="Center" MinWidth="120"
                              MaxDropDownHeight="220" PlaceholderText="Ninguna"/>
                    <TextBox Grid.Column="7" Text="{Binding Author, Mode=TwoWay}"
                             MinWidth="120" VerticalContentAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>

      <!-- Output -->
      <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
        <TextBlock Grid.Column="0" Text="Salida:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Grid.Column="1" Text="{Binding OutputPath, Mode=TwoWay}" Watermark="Ruta del .wad compilado (ej. megawad.wad)"/>
        <Button Grid.Column="2" Content="..." Click="OnBrowseOutput" Margin="4,0,0,0"/>
      </Grid>

      <!-- Log -->
      <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" RowDefinitions="Auto,*">
        <TextBlock Text="Registro" FontWeight="Bold" Margin="0,4,0,4"/>
        <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" FontFamily="Consolas, Courier New"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </Grid>

    </Grid>
  </DockPanel>
</Window>