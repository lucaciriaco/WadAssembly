          <Path Data="{StaticResource Icon.Project}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </MenuItem.Icon>
        <MenuItem Header="{DynamicResource Menu.ProjectSettings}" Click="OnProjectSettings">
          <MenuItem.Icon>
