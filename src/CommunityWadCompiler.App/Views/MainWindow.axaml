          <Path Data="{StaticResource Icon.File}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </MenuItem.Icon>
        <MenuItem Header="{DynamicResource Menu.NewProject}" Click="OnNewProject">
          <MenuItem.Icon>
            <Path Data="{StaticResource Icon.NewProject}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="{DynamicResource Menu.OpenProject}" Click="OnOpenProject">
          <MenuItem.Icon>
            <Path Data="{StaticResource Icon.OpenProject}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{DynamicResource Menu.SaveProject}" Click="OnSaveProject">
          <MenuItem.Icon>
            <Path Data="{StaticResource Icon.SaveProject}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{DynamicResource Menu.SaveProjectAs}" Click="OnSaveProjectAs">
          <MenuItem.Icon>
            <Path Data="{StaticResource Icon.SaveProjectAs}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="{DynamicResource Menu.Exit}" Click="OnExit">
          <MenuItem.Icon>
            <Path Data="{StaticResource Icon.Exit}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu.Project}">
