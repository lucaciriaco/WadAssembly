<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CommunityWadCompiler.App.ViewModels"
        xmlns:input="using:Avalonia.Input"
        x:Class="CommunityWadCompiler.App.Views.MainWindow"
        Title="Community Wad Compiler"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  

  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="Archivo">
        <MenuItem Header="Nuevo proyecto" Click="OnNewProject"/>
        <Separator/>
        <MenuItem Header="Abrir proyecto..." Click="OnOpenProject"/>
        <MenuItem Header="Guardar proyecto" Click="OnSaveProject"/>
        <MenuItem Header="Guardar proyecto como..." Click="OnSaveProjectAs"/>
        <Separator/>
        <MenuItem Header="Configuración del proyecto..." Click="OnProjectSettings"/>
        <Separator/>
        <MenuItem Header="Salir" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="Ayuda">
        <MenuItem Header="Acerca de..." Click="OnAbout"/>
      </MenuItem>
    </Menu>

    <!-- Bottom bar: output path (browse button at the bottom-left corner), progress, compile -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="8,4,8,8">
      <Button Grid.Column="0" Content="..." Click="OnBrowseOutput" MinWidth="36"
              VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="Salida:" VerticalAlignment="Center" Margin="6,0,6,0"/>
      <TextBox Grid.Column="2" Text="{Binding OutputPath, Mode=TwoWay}"
               Watermark="Ruta del .wad compilado (ej. megawad.wad)" VerticalAlignment="Center"/>
      <ProgressBar Grid.Column="3" Width="220" Height="18" IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Margin="8,0,0,0"/>
      <Button Grid.Column="4" HorizontalAlignment="Right" Content="Compilar"
              IsDefault="True" Click="OnCompile" MinWidth="120" Margin="8,0,0,0"/>
    </Grid>

    <Grid Margin="8" RowDefinitions="3*,*" ColumnDefinitions="*,2*">

      <!-- Left: input WADs -->
      <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
        <TextBlock DockPanel.Dock="Top" Text="WADs aportados (mapas)" FontWeight="Bold" Margin="0,0,0,2"/>
        <TextBlock DockPanel.Dock="Top" Text="Elegí un mapa (dropdown si hay varios) y arrastralo a un slot de la planilla."
                   Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
          <Button Content="Agregar WADs..." Click="OnAddWads"/>
          <Button Content="Quitar" Click="OnRemoveWad"/>
          <Button Content="Subir" Click="OnMoveUp"/>
          <Button Content="Bajar" Click="OnMoveDown"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding InputWads}"
                 SelectedItem="{Binding SelectedWad, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent" Cursor="Hand"
                          PointerPressed="OnWadPointerPressed"
                          PointerMoved="OnWadPointerMoved"
                          PointerReleased="OnWadPointerReleased">
                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding MapNames}"
                          SelectedItem="{Binding SelectedMapName, Mode=TwoWay}"
                          IsVisible="{Binding HasMultipleMaps}"
                          MinWidth="90" MaxDropDownHeight="220"
                          VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

<!-- Right: maps / slots -->
      <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
        <TextBlock DockPanel.Dock="Top" Text="{Binding MapsHeader}"
                   FontWeight="Bold" Margin="0,0,0,4"/>
<Border BorderBrush="#808080" BorderThickness="1" CornerRadius="3">
          <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
<StackPanel>
              <!-- Header: scrolls horizontally WITH the rows -->
              <Grid x:Name="HeaderGrid" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="170"/>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="130"/>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Slot" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Grid.Column="1" Text="WAD" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Grid.Column="2" Text="Mapa original" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Grid.Column="3" Text="Nombre del mapa" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Grid.Column="4" Text="Estado" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Grid.Column="5" Text="Última modificación" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Grid.Column="6" Text="Música" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Grid.Column="6" Text="Sky" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Grid.Column="7" Text="Autor" FontWeight="Bold" Margin="4,0,4,0"/>
              </Grid>
              <!-- Rows -->
              <ItemsControl ItemsSource="{Binding SlotRows}"
                        input:DragDrop.AllowDrop="True"
                        input:DragDrop.DragOver="OnSlotDragOver"
                        input:DragDrop.DragLeave="OnSlotDragLeave"
                        input:DragDrop.Drop="OnSlotDrop">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="2,3"
                            Background="{Binding RowBackground}" Cursor="Hand"
                            PointerPressed="OnSlotPointerPressed"
                            PointerMoved="OnSlotPointerMoved"
                            PointerReleased="OnSlotPointerReleased">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="90"/>
                          <ColumnDefinition Width="140"/>
                          <ColumnDefinition Width="100"/>
                          <ColumnDefinition Width="170"/>
                          <ColumnDefinition Width="100"/>
                          <ColumnDefinition Width="160"/>
                          <ColumnDefinition Width="130"/>
                          <ColumnDefinition Width="100"/>
                          <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Borrar todos los campos" Click="OnClearSlotFields"/>
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <TextBox Grid.Column="0" Text="{Binding SlotName, Mode=TwoWay}"
                                 MinWidth="60" VerticalContentAlignment="Center" Margin="4,0,4,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding WadFileName}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding OriginalName}"
                                   VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <TextBox Grid.Column="3" Text="{Binding LevelName, Mode=TwoWay}"
                                 MinWidth="110" VerticalContentAlignment="Center" Margin="4,0,4,0"/>
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{x:Static vm:SlotRowViewModel.StatusOptions}"
                                  SelectedItem="{Binding Status, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  MaxDropDownHeight="220"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalAlignment="Stretch">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,4,0"
                                        Background="{Binding Converter={x:Static vm:StatusToColorConverter.Instance}}"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                          </ComboBox>
                        <TextBlock Grid.Column="5" Text="{Binding LastModified}"
                                   VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <Button Grid.Column="6" Content="{Binding MusicDisplay}" MinWidth="110"
                            Padding="8,2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Click="OnPickMusic" Margin="4,0,4,0"/>
                        <Button Grid.Column="7" Content="{Binding SkyName}" MinWidth="90"
                            Padding="8,2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Click="OnPickSky" Margin="4,0,4,0"/>
                        <TextBox Grid.Column="8" Text="{Binding Author, Mode=TwoWay}"
                                 MinWidth="120" VerticalContentAlignment="Center" Margin="4,0,4,0"/>
                      </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </DockPanel>

      <!-- Log -->
      <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" RowDefinitions="Auto,*">
        <TextBlock Text="Registro" FontWeight="Bold" Margin="0,4,0,4"/>
        <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" FontFamily="Consolas, Courier New"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </Grid>

    </Grid>
  </DockPanel>
</Window>