          <MenuItem x:Name="ThemeMenuSystem" Header="{DynamicResource Menu.Theme.System}" Click="OnThemeSystem">
            <MenuItem.Icon>
              <TextBlock x:Name="ThemeCheckSystem" Text=" " MinWidth="16" TextAlignment="Center"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="ThemeMenuLight" Header="{DynamicResource Menu.Theme.Light}" Click="OnThemeLight">
            <MenuItem.Icon>
              <TextBlock x:Name="ThemeCheckLight" Text=" " MinWidth="16" TextAlignment="Center"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="ThemeMenuDark" Header="{DynamicResource Menu.Theme.Dark}" Click="OnThemeDark">
            <MenuItem.Icon>
              <TextBlock x:Name="ThemeCheckDark" Text=" " MinWidth="16" TextAlignment="Center"/>
            </MenuItem.Icon>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="{DynamicResource Menu.View}" x:Name="ViewColumnsMenu">
          <MenuItem.Icon>
            <Path Data="{StaticResource Icon.View}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu.Help}">
        <MenuItem.Icon>
          <Path Data="{StaticResource Icon.Help}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </MenuItem.Icon>
        <MenuItem Header="{DynamicResource Menu.About}" Click="OnAbout">
          <MenuItem.Icon>
            <Path Data="{StaticResource Icon.About}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
    </Menu>

    <!-- Bottom bar: output path (browse button at the bottom-left corner), progress, compile -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="8,4,8,8">
      <Button Grid.Column="0" Click="OnBrowseOutput" MinWidth="36"
              VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Output.Label}">
        <Path Data="{StaticResource Icon.OpenProject}" Width="16" Height="16" Stretch="Uniform"
              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
      </Button>
      <TextBlock Grid.Column="1" Text="{DynamicResource Output.Label}" VerticalAlignment="Center" Margin="6,0,6,0"/>
      <TextBox Grid.Column="2" Text="{Binding OutputPath, Mode=TwoWay}"
               Watermark="{DynamicResource Output.Watermark}" VerticalAlignment="Center"/>
      <ProgressBar Grid.Column="3" Width="220" Height="18" IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Margin="8,0,0,0"/>
      <Button Grid.Column="4" HorizontalAlignment="Right"
              IsDefault="True" Click="OnCompile" MinWidth="120" Margin="8,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Data="{StaticResource Icon.Compile}" Width="16" Height="16" Stretch="Uniform"
                Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="{DynamicResource Compile}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>

    <Grid x:Name="LayoutGrid" Margin="8" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="4*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="1*" MinHeight="80"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="2*"/>
    </Grid.ColumnDefinitions>

      <!-- Collapse toggle strip: always visible so the WAD panel can be re-expanded. -->
      <Button Grid.Row="0" Grid.Column="0" x:Name="HamburgerButton" Click="OnToggleLeftPanel"
              Width="30" Height="30" Margin="0,2,6,0" VerticalAlignment="Top" Background="Transparent"
              ToolTip.Tip="{DynamicResource Input.Collapse}">
        <Path x:Name="CollapseIcon" Data="{StaticResource Icon.ArrowLeft}" Width="18" Height="18" Stretch="Uniform"
              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
      </Button>

      <!-- Left: input WADs -->
      <DockPanel x:Name="LeftPanel" Grid.Row="0" Grid.Column="1" MinWidth="150" Margin="0,0,8,8">
        <TextBlock x:Name="InputHeader" DockPanel.Dock="Top" Text="{DynamicResource Input.Title}"
                   FontWeight="Bold" Margin="0,0,0,2"/>
        <DockPanel x:Name="WadHintPanel" DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="WadHintDismiss" DockPanel.Dock="Right" Click="OnDismissWadHint"
                  Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                  Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                  ToolTip.Tip="{DynamicResource Input.HideHint}">
            <TextBlock Text="✕" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
          </Button>
          <TextBlock Text="{DynamicResource Input.Hint}" Foreground="Gray"
                     TextWrapping="Wrap" Margin="0,1,4,0"/>
        </DockPanel>
        <WrapPanel DockPanel.Dock="Bottom" ItemSpacing="6" Margin="0,6,0,0">
          <Button Click="OnAddWads">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Data="{StaticResource Icon.AddWads}" Width="16" Height="16" Stretch="Uniform"
                    Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Input.AddWads}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Click="OnRemoveWad">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Data="{StaticResource Icon.Remove}" Width="16" Height="16" Stretch="Uniform"
                    Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Input.Remove}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Click="OnMoveUp" ToolTip.Tip="{DynamicResource Input.MoveUp}">
            <Path Data="{StaticResource Icon.MoveUp}" Width="16" Height="16" Stretch="Uniform"
                  Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="6,2"/>
          </Button>
          <Button Click="OnMoveDown" ToolTip.Tip="{DynamicResource Input.MoveDown}">
            <Path Data="{StaticResource Icon.MoveDown}" Width="16" Height="16" Stretch="Uniform"
                  Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="6,2"/>
          </Button>
        </WrapPanel>
        <ListBox ItemsSource="{Binding InputWads}"
                 SelectedItem="{Binding SelectedWad, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent" Cursor="Hand"
                          PointerPressed="OnWadPointerPressed"
                          PointerMoved="OnWadPointerMoved"
                          PointerReleased="OnWadPointerReleased">
                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding MapNames}"
                          SelectedItem="{Binding SelectedMapName, Mode=TwoWay}"
                          IsVisible="{Binding HasMultipleMaps}"
                          MinWidth="90" MaxDropDownHeight="220"
                          VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Vertical splitter: resize the left "contributed WADs" panel -->
      <GridSplitter x:Name="LeftPanelSplitter" Grid.Row="0" Grid.Column="2"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="6"
                    Background="{DynamicResource SystemControlForegroundBaseHighBrush}" Opacity="0.3"
                    Focusable="False" Cursor="SizeWestEast"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    DragCompleted="OnLeftPanelSplitterCompleted"/>

      <!-- Right: maps / slots -->
      <DockPanel Grid.Row="0" Grid.Column="3" MinWidth="300" Margin="0,0,0,8">
        <TextBlock DockPanel.Dock="Top" Text="{Binding MapsHeader}"
                   FontWeight="Bold" Margin="0,0,0,4"/>
<Border BorderBrush="#808080" BorderThickness="1" CornerRadius="3">
          <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
<StackPanel>
              <!-- Header: scrolls horizontally WITH the rows -->
              <Grid x:Name="HeaderGrid" Margin="0,0,0,2" input:DragDrop.AllowDrop="True"
                      input:DragDrop.DragOver="OnHeaderDragOver"
                      input:DragDrop.Drop="OnHeaderDrop">
                <Grid.Styles>
                  <Style Selector="Border.divider">
                    <Setter Property="Width" Value="2"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Opacity" Value="0.35"/>
                    <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                  </Style>
                  <Style Selector="TextBlock">
                    <Setter Property="Cursor" Value="SizeAll"/>
                  </Style>
                </Grid.Styles>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding C0, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW0, Source={StaticResource PlanColWidths}}"/>
                  <ColumnDefinition Width="{Binding C1, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW1, Source={StaticResource PlanColWidths}}"/>
                  <ColumnDefinition Width="{Binding C2, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW2, Source={StaticResource PlanColWidths}}"/>
                  <ColumnDefinition Width="{Binding C3, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW3, Source={StaticResource PlanColWidths}}"/>
                  <ColumnDefinition Width="{Binding C4, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW4, Source={StaticResource PlanColWidths}}"/>
                  <ColumnDefinition Width="{Binding C5, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW5, Source={StaticResource PlanColWidths}}"/>
                  <ColumnDefinition Width="{Binding C6, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW6, Source={StaticResource PlanColWidths}}"/>
                  <ColumnDefinition Width="{Binding C7, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW7, Source={StaticResource PlanColWidths}}"/>
                  <ColumnDefinition Width="{Binding C8, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW8, Source={StaticResource PlanColWidths}}"/>
                  <ColumnDefinition Width="{Binding C9, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW9, Source={StaticResource PlanColWidths}}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Tag="0" Grid.Column="0" Text="{DynamicResource Header.Slot}" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Tag="1" Grid.Column="1" Text="{DynamicResource Header.Wad}" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Tag="2" Grid.Column="2" Text="{DynamicResource Header.OriginalMap}" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Tag="3" Grid.Column="3" Text="{DynamicResource Header.LevelName}" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Tag="4" Grid.Column="4" Text="{DynamicResource Header.Status}" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Tag="5" Grid.Column="5" Text="{DynamicResource Header.LastModified}" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Tag="6" Grid.Column="6" Text="{DynamicResource Header.Music}" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Tag="7" Grid.Column="7" Text="{DynamicResource Header.Sky}" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Tag="8" Grid.Column="8" Text="{DynamicResource Header.Author}" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Tag="9" Grid.Column="9" Text="{DynamicResource Header.Notes}" FontWeight="Bold" Margin="4,0,4,0"/>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                              HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Margin="-3,0,0,0"
                              Background="Transparent" Focusable="False" Cursor="SizeWestEast"
                              DragDelta="OnColumnResized" DragCompleted="OnColumnResized"/>
                <GridSplitter Grid.Column="2" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                              HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Margin="-3,0,0,0"
                              Background="Transparent" Focusable="False" Cursor="SizeWestEast"
                              DragDelta="OnColumnResized" DragCompleted="OnColumnResized"/>
                <GridSplitter Grid.Column="3" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                              HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Margin="-3,0,0,0"
                              Background="Transparent" Focusable="False" Cursor="SizeWestEast"
                              DragDelta="OnColumnResized" DragCompleted="OnColumnResized"/>
                <GridSplitter Grid.Column="4" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                              HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Margin="-3,0,0,0"
                              Background="Transparent" Focusable="False" Cursor="SizeWestEast"
                              DragDelta="OnColumnResized" DragCompleted="OnColumnResized"/>
                <GridSplitter Grid.Column="5" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                              HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Margin="-3,0,0,0"
                              Background="Transparent" Focusable="False" Cursor="SizeWestEast"
                              DragDelta="OnColumnResized" DragCompleted="OnColumnResized"/>
                <GridSplitter Grid.Column="6" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                              HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Margin="-3,0,0,0"
                              Background="Transparent" Focusable="False" Cursor="SizeWestEast"
                              DragDelta="OnColumnResized" DragCompleted="OnColumnResized"/>
                <GridSplitter Grid.Column="7" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                              HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Margin="-3,0,0,0"
                              Background="Transparent" Focusable="False" Cursor="SizeWestEast"
                              DragDelta="OnColumnResized" DragCompleted="OnColumnResized"/>
                <GridSplitter Grid.Column="8" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                              HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Margin="-3,0,0,0"
                              Background="Transparent" Focusable="False" Cursor="SizeWestEast"
                              DragDelta="OnColumnResized" DragCompleted="OnColumnResized"/>
                <GridSplitter Grid.Column="9" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                              HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Margin="-3,0,0,0"
                              Background="Transparent" Focusable="False" Cursor="SizeWestEast"
                              DragDelta="OnColumnResized" DragCompleted="OnColumnResized"/>
                <Border Grid.Column="1" Classes="divider"/>
                <Border Grid.Column="2" Classes="divider"/>
                <Border Grid.Column="3" Classes="divider"/>
                <Border Grid.Column="4" Classes="divider"/>
                <Border Grid.Column="5" Classes="divider"/>
                <Border Grid.Column="6" Classes="divider"/>
                <Border Grid.Column="7" Classes="divider"/>
                <Border Grid.Column="8" Classes="divider"/>
                <Border Grid.Column="9" Classes="divider"/>
              </Grid>
              <!-- Rows -->
              <ItemsControl x:Name="RowsControl" ItemsSource="{Binding SlotRows}"
                      input:DragDrop.AllowDrop="True"
                        input:DragDrop.DragOver="OnSlotDragOver"
                        input:DragDrop.DragLeave="OnSlotDragLeave"
                        input:DragDrop.Drop="OnSlotDrop">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="2,3"
                            Background="{Binding RowBackground}" Cursor="Hand"
                            AttachedToVisualTree="OnRowAttachedToVisualTree"
                            PointerPressed="OnSlotPointerPressed"
                            PointerMoved="OnSlotPointerMoved"
                            PointerReleased="OnSlotPointerReleased">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding C0, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW0, Source={StaticResource PlanColWidths}}"/>
                          <ColumnDefinition Width="{Binding C1, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW1, Source={StaticResource PlanColWidths}}"/>
                          <ColumnDefinition Width="{Binding C2, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW2, Source={StaticResource PlanColWidths}}"/>
                          <ColumnDefinition Width="{Binding C3, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW3, Source={StaticResource PlanColWidths}}"/>
                          <ColumnDefinition Width="{Binding C4, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW4, Source={StaticResource PlanColWidths}}"/>
                          <ColumnDefinition Width="{Binding C5, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW5, Source={StaticResource PlanColWidths}}"/>
                          <ColumnDefinition Width="{Binding C6, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW6, Source={StaticResource PlanColWidths}}"/>
                          <ColumnDefinition Width="{Binding C7, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW7, Source={StaticResource PlanColWidths}}"/>
                          <ColumnDefinition Width="{Binding C8, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW8, Source={StaticResource PlanColWidths}}"/>
                          <ColumnDefinition Width="{Binding C9, Source={StaticResource PlanColWidths}}" MinWidth="{Binding MinW9, Source={StaticResource PlanColWidths}}"/>
                        </Grid.ColumnDefinitions>
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{DynamicResource Row.ClearFields}" Click="OnClearSlotFields"/>
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <TextBox Tag="0" Grid.Column="0" Text="{Binding SlotName, Mode=TwoWay}"
                                 MinWidth="60" VerticalContentAlignment="Center" Margin="4,0,4,0"/>
                        <TextBlock Tag="1" Grid.Column="1" Text="{Binding WadFileName}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <TextBlock Tag="2" Grid.Column="2" Text="{Binding OriginalName}"
                                   VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <TextBox Tag="3" Grid.Column="3" Text="{Binding LevelName, Mode=TwoWay}"
                                 MinWidth="110" VerticalContentAlignment="Center" Margin="4,0,4,0"/>
                        <ComboBox Tag="4" Grid.Column="4"
                                  ItemsSource="{x:Static vm:SlotRowViewModel.StatusOptions}"
                                  SelectedItem="{Binding Status, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  MaxDropDownHeight="220"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalAlignment="Stretch">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,4,0"
                                        Background="{Binding Converter={x:Static vm:StatusToColorConverter.Instance}}"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                          </ComboBox>
                        <TextBlock Tag="5" Grid.Column="5" Text="{Binding LastModified}"
                                   VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <Button Tag="6" Grid.Column="6" Content="{Binding MusicDisplay}" MinWidth="110"
                            Padding="8,2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Click="OnPickMusic" Margin="4,0,4,0"/>
                        <Button Tag="7" Grid.Column="7" Content="{Binding SkyDisplay}" MinWidth="90"
                            Padding="8,2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Click="OnPickSky" Margin="4,0,4,0"/>
                        <TextBox Tag="8" Grid.Column="8" Text="{Binding Author, Mode=TwoWay}"
                                 MinWidth="120" VerticalContentAlignment="Center" Margin="4,0,4,0"/>
                        <Button Tag="9" Grid.Column="9" Click="OnEditNotes" MinWidth="90"
                            Padding="8,2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Margin="4,0,4,0">
                          <TextBlock Text="{Binding NotesDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Button>
                      </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </DockPanel>

      <!-- Horizontal splitter: resize the log area -->
      <GridSplitter x:Name="LogSplitter" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="6"
                    Background="{DynamicResource SystemControlForegroundBaseHighBrush}" Opacity="0.3"
                    Focusable="False" Cursor="SizeNorthSouth"
                    ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

      <!-- Log -->
      <Grid x:Name="LogPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" RowDefinitions="Auto,*">
        <TextBlock x:Name="LogTitle" Text="{DynamicResource Log.Title}" FontWeight="Bold" Margin="0,4,0,4"/>
        <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" FontFamily="Consolas, Courier New"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </Grid>

    </Grid>
  </DockPanel>
</Window>