<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="CommunityWadCompiler.App.Resources.Strings_en">

  <!-- ===== Main menu ===== -->
  <sys:String x:Key="Menu.File">File</sys:String>
  <sys:String x:Key="Menu.NewProject">New project</sys:String>
  <sys:String x:Key="Menu.OpenProject">Open project...</sys:String>
  <sys:String x:Key="Menu.OpenRecent">Open recent</sys:String>
  <sys:String x:Key="Menu.Recent.Empty">No recent projects</sys:String>
  <sys:String x:Key="Menu.SaveProject">Save project</sys:String>
  <sys:String x:Key="Menu.SaveProjectAs">Save project as...</sys:String>
  <sys:String x:Key="Menu.ProjectSettings">Project settings...</sys:String>
  <sys:String x:Key="Menu.ProjectSummary">Project summary...</sys:String>
  <sys:String x:Key="Menu.Project">Project</sys:String>
  <sys:String x:Key="Menu.Configuration">Configuration</sys:String>
  <sys:String x:Key="Menu.Language">Language</sys:String>
  <sys:String x:Key="Menu.Language.Español">Español</sys:String>
  <sys:String x:Key="Menu.Language.English">English</sys:String>
  <sys:String x:Key="Menu.Theme">Theme</sys:String>
  <sys:String x:Key="Menu.Theme.System">System</sys:String>
  <sys:String x:Key="Menu.Theme.Light">Light</sys:String>
  <sys:String x:Key="Menu.Theme.Dark">Dark</sys:String>
  <sys:String x:Key="Menu.View">View</sys:String>
  <sys:String x:Key="Menu.ColorByStatus">Color status cell</sys:String>
  <sys:String x:Key="Menu.SourcePorts">Source ports...</sys:String>
  <sys:String x:Key="Menu.Exit">Exit</sys:String>
  <sys:String x:Key="Menu.Help">Help</sys:String>
  <sys:String x:Key="Menu.About">About...</sys:String>

  <!-- ===== Bottom bar ===== -->
  <sys:String x:Key="Output.Label">Output:</sys:String>
  <sys:String x:Key="Output.Watermark">Path of the compiled .wad (e.g. megawad.wad)</sys:String>
  <sys:String x:Key="Compile">Compile</sys:String>
  <sys:String x:Key="Compile.Mode">Compile button mode</sys:String>
  <sys:String x:Key="Compile.Mode.Build">Build</sys:String>
  <sys:String x:Key="Compile.Mode.BuildRun">Build and run</sys:String>

  <!-- ===== Left panel: input WADs ===== -->
  <sys:String x:Key="Input.Title">Contributed WADs (maps)</sys:String>
  <sys:String x:Key="Input.Hint">Pick a map (dropdown if there are several) and drag it into a slot of the sheet.</sys:String>
  <sys:String x:Key="Input.HideHint">Hide hint</sys:String>
  <sys:String x:Key="Input.AddWads">Add WADs...</sys:String>
  <sys:String x:Key="Input.Remove">Remove</sys:String>
  <sys:String x:Key="Input.MoveUp">Move up</sys:String>
  <sys:String x:Key="Input.MoveDown">Move down</sys:String>
  <sys:String x:Key="Input.Collapse">Collapse WAD list panel</sys:String>
  <sys:String x:Key="Input.Expand">Expand WAD list panel</sys:String>

  <!-- ===== Sheet headers ===== -->
  <sys:String x:Key="Header.Slot">Slot</sys:String>
  <sys:String x:Key="Header.Wad">WAD</sys:String>
  <sys:String x:Key="Header.OriginalMap">Original map</sys:String>
  <sys:String x:Key="Header.LevelName">Map name</sys:String>
  <sys:String x:Key="Header.Status">Status</sys:String>
  <sys:String x:Key="Header.LastModified">Last modified</sys:String>
  <sys:String x:Key="Header.Music">Music</sys:String>
  <sys:String x:Key="Header.Sky">Sky</sys:String>
  <sys:String x:Key="Header.Author">Author</sys:String>
  <sys:String x:Key="Header.Notes">Additional notes</sys:String>

  <!-- ===== Notes window ===== -->
  <sys:String x:Key="Notes.Title">Additional notes</sys:String>
  <sys:String x:Key="Notes.SlotLabel">Notes for slot {0}</sys:String>
  <sys:String x:Key="Notes.Placeholder">Notes...</sys:String>

  <!-- ===== Row context menu ===== -->
  <sys:String x:Key="Row.ClearFields">Clear all fields</sys:String>

  <!-- ===== Log ===== -->
  <sys:String x:Key="Log.Title">Log</sys:String>
  <sys:String x:Key="Log.Hide">Hide console</sys:String>
  <sys:String x:Key="Log.Show">Show console</sys:String>
  <sys:String x:Key="Log.Search">Search log...</sys:String>
  <sys:String x:Key="Log.Error">Error</sys:String>
  <sys:String x:Key="Log.Warning">Warning</sys:String>
  <sys:String x:Key="Log.Info">Info</sys:String>

  <!-- ===== Project Settings window ===== -->
  <sys:String x:Key="ProjectSettings.Title">Project settings</sys:String>
  <sys:String x:Key="Accept">OK</sys:String>
  <sys:String x:Key="Cancel">Cancel</sys:String>
  <sys:String x:Key="ProjectSettings.ProjectName">Project name</sys:String>
  <sys:String x:Key="ProjectSettings.ProjectName.Watermark">e.g. La Hermandad de la Arena</sys:String>
  <sys:String x:Key="ProjectSettings.Version">Version (editable prefix)</sys:String>
  <sys:String x:Key="ProjectSettings.Version.Watermark">e.g. 1.2.3 — the compile suffix is appended automatically (1.2.3.145001)</sys:String>
  <sys:String x:Key="ProjectSettings.SlotCount">Number of PWAD slots</sys:String>
  <sys:String x:Key="ProjectSettings.BaseWad">Base WAD (IWAD)</sys:String>
  <sys:String x:Key="ProjectSettings.BaseWad.Watermark">Optional. DOOM2.WAD as seed for TEXTURE1/PNAMES.</sys:String>
  <sys:String x:Key="ProjectSettings.Clear">Clear</sys:String>
  <sys:String x:Key="ProjectSettings.IntermissionMusic">Intermission music</sys:String>
  <sys:String x:Key="ProjectSettings.IntermissionMusic.Watermark">Music played between levels (intermission)</sys:String>
  <sys:String x:Key="ProjectSettings.IntermissionMusic.Pick">Open music picker...</sys:String>
  <sys:String x:Key="ProjectSettings.SourcePort">Source port for "Build and run"</sys:String>
  <sys:String x:Key="ProjectSettings.SourcePort.Watermark">None — the button only builds</sys:String>
  <sys:String x:Key="ProjectSettings.ResourceWads">Resource WADs (textures / flats)</sys:String>
  <sys:String x:Key="ProjectSettings.AddResources">Add resources...</sys:String>
  <sys:String x:Key="ProjectSettings.FilterToUsed">Only include textures/flats used by the maps</sys:String>
  <sys:String x:Key="ProjectSettings.IncludePalette">Include palette lumps (PLAYPAL, COLORMAP, etc.)</sys:String>
  <sys:String x:Key="ProjectSettings.IncludeSprites">Include sprites (S_START..S_END, SS/ST/STRT/FM_START..END: sprites, status bar and fonts)</sys:String>
  <sys:String x:Key="ProjectSettings.MapInfoNotes">Write notes/comments into the MAPINFO (author, status, build date, etc.)</sys:String>
  <sys:String x:Key="ProjectSettings.BaseTexturesOverride">Prefer base IWAD textures over resource WAD textures (if unchecked, resource textures replace the IWAD's)</sys:String>
  <sys:String x:Key="ProjectSettings.TargetEngine">Target engine</sys:String>
  <sys:String x:Key="ProjectSettings.Beta">beta</sys:String>
  <sys:String x:Key="ProjectSettings.AnimatedRuns">Import numbered animation runs used by the maps (packs without an ANIMATED/ANIMDEFS lump)</sys:String>
  <sys:String x:Key="ProjectSettings.MaxAnimatedFrames">Max frames per animated run</sys:String>
  <sys:String x:Key="ProjectSettings.GenerateAnimdefs">Generate an ANIMDEFS lump for the numbered animated runs so they actually animate (ZDoom-family ports)</sys:String>

  <sys:String x:Key="ProjectSettings.GenerateAnimated">Generate a binary ANIMATED lump for the numbered animated runs so they actually animate (Boom-based ports such as Odamex)</sys:String>

  <sys:String x:Key="ProjectSettings.GenerateSwitches">Generate a binary SWITCHES lump for the pack's SW1xxx/SW2xxx switches so they work in Boom-based ports such as Odamex</sys:String>
  <sys:String x:Key="ProjectSettings.AnimatedTics">Tics per frame (35 = 1 second)</sys:String>
  <sys:String x:Key="ProjectSettings.AnimatedPrefixes">Prefixes to animate (comma-separated)</sys:String>
  <sys:String x:Key="ProjectSettings.AnimatedPrefixesHint">Only runs whose prefixes are listed (e.g. SHAWN, WATR) are declared as animations. Static variants such as SKY1/SKY2 or BIGDOOR1..7 stay static.</sys:String>
  <sys:String x:Key="ProjectSettings.Collaborators">Collaborators (map authors)</sys:String>
  <sys:String x:Key="ProjectSettings.AddCollaborator">Add collaborator</sys:String>

  <!-- ===== Source Ports window ===== -->
  <sys:String x:Key="SourcePorts.Title">Source ports</sys:String>
  <sys:String x:Key="SourcePorts.List">Configured ports</sys:String>
  <sys:String x:Key="SourcePorts.Add">Add port</sys:String>
  <sys:String x:Key="SourcePorts.Edit">Edit selected port</sys:String>
  <sys:String x:Key="SourcePorts.Name">Name</sys:String>
  <sys:String x:Key="SourcePorts.Name.Watermark">e.g. GZDoom</sys:String>
  <sys:String x:Key="SourcePorts.Executable">Executable</sys:String>
  <sys:String x:Key="SourcePorts.Executable.Watermark">Path to the source port .exe</sys:String>
  <sys:String x:Key="SourcePorts.Executable.Browse">Browse for executable...</sys:String>
  <sys:String x:Key="SourcePorts.Arguments">Arguments</sys:String>
  <sys:String x:Key="SourcePorts.Arguments.Watermark">Optional. e.g. -warp 1 — -iwad and -file are added automatically</sys:String>

  <!-- ===== Sky Picker window ===== -->
  <sys:String x:Key="SkyPicker.Title">Select Sky</sys:String>
  <sys:String x:Key="SkyPicker.Hint">Choose the sky texture for the map. You can type a manual name or pick from the texture list of the resource WAD.</sys:String>
  <sys:String x:Key="SkyPicker.ManualLabel">Manual SKYNAME:</sys:String>
  <sys:String x:Key="SkyPicker.ManualWatermark">e.g. SKY1, RSKY1, F_SKY1...</sys:String>
  <sys:String x:Key="SkyPicker.FilterLabel">Filter textures:</sys:String>
  <sys:String x:Key="SkyPicker.FilterWatermark">Search texture...</sys:String>
  <sys:String x:Key="SkyPicker.ListTitle">Textures available in resource WADs:</sys:String>
  <sys:String x:Key="SkyPicker.Preview">Preview</sys:String>
  <sys:String x:Key="SkyPicker.PreviewHint">Select a texture to see the preview</sys:String>
  <sys:String x:Key="SkyPicker.PreviewNotAvailable">Preview not available (VM not set)</sys:String>
  <sys:String x:Key="SkyPicker.NotFound">'{0}' not found in resource WADs</sys:String>
  <sys:String x:Key="SkyPicker.UnsupportedFormat">Unsupported format for preview: {0} ({1} bytes)</sys:String>
  <sys:String x:Key="SkyPicker.RotSpeedLabel">Rotation speed:</sys:String>
  <sys:String x:Key="SkyPicker.RotSpeed2Label">Sky2 rotation speed:</sys:String>
  <sys:String x:Key="SkyPicker.RotSpeedWatermark">0 = no rotation</sys:String>
  <sys:String x:Key="SkyPicker.Sky2Check">Use sky2</sys:String>
  <sys:String x:Key="SkyPicker.Sky2Label">Sky2 SKYNAME (optional):</sys:String>
  <sys:String x:Key="SkyPicker.Sky2Watermark">e.g. SKYFOG, SKYWALL...</sys:String>

  <!-- ===== Music Picker window ===== -->
  <sys:String x:Key="MusicPicker.Title">Select music</sys:String>
  <sys:String x:Key="MusicPicker.Hint">Choose the music for the slot or load an external file (MIDI/MOD/IT).</sys:String>
  <sys:String x:Key="MusicPicker.LoadExternal">Load external file...</sys:String>

  <!-- ===== Misc strings (display, VM) ===== -->
  <sys:String x:Key="NoMusic">None</sys:String>
  <sys:String x:Key="Wad.Kind.Input">contributed</sys:String>
  <sys:String x:Key="Wad.Kind.Resources">resources</sys:String>
  <sys:String x:Key="Wad.MapCountFormat"> | {0} map(s)</sys:String>
  <sys:String x:Key="Wad.DisplayFormat">{0}   [{1} | {2}]{3}</sys:String>
  <sys:String x:Key="Music.ExtMark">[ext]</sys:String>
  <sys:String x:Key="Music.FromWadFormat">{0}   [from {1}]</sys:String>

  <!-- ===== File dialogs ===== -->
  <sys:String x:Key="Dialog.PickInputWads">Select contributed WADs</sys:String>
  <sys:String x:Key="Dialog.SaveOutputWad">Save compiled WAD</sys:String>
  <sys:String x:Key="Dialog.ProjectFilter">Community Wad Project</sys:String>
  <sys:String x:Key="Dialog.OpenProject">Open project</sys:String>
  <sys:String x:Key="Dialog.SaveProject">Save project</sys:String>
  <sys:String x:Key="Dialog.SuggestedProjectName">project.json</sys:String>
  <sys:String x:Key="Dialog.About">About</sys:String>
  <sys:String x:Key="Dialog.RecentMissing">Project unavailable</sys:String>
  <sys:String x:Key="Dialog.RecentMissingText">The project file no longer exists:

{0}</sys:String>
  <sys:String x:Key="Dialog.ProjectSummary">Project summary</sys:String>
  <sys:String x:Key="Dialog.Copy">Copy to clipboard</sys:String>
  <sys:String x:Key="Dialog.SummarySave">Save as...</sys:String>
  <sys:String x:Key="Dialog.SummaryFilter">Markdown</sys:String>
  <sys:String x:Key="Dialog.SuggestedSummaryName">summary.md</sys:String>
  <sys:String x:Key="Dialog.SummaryCopied">Summary copied to clipboard</sys:String>
  <sys:String x:Key="Dialog.SummarySlots">Slots</sys:String>
  <sys:String x:Key="Dialog.SummaryOf">of</sys:String>
  <sys:String x:Key="Dialog.SummaryEngine">Engine</sys:String>
  <sys:String x:Key="Dialog.SummaryAuthors">Authors</sys:String>
  <sys:String x:Key="Dialog.SummaryNoMaps">No maps assigned yet.</sys:String>
  <sys:String x:Key="Dialog.AboutName">WadAssembly</sys:String>
  <sys:String x:Key="Dialog.MadeBy">Made by Luca Ciriaco</sys:String>
  <sys:String x:Key="Dialog.AboutText">Compiles WADs from several authors into a single PWAD.&#x0a;Supports classic Doom and UDMF maps, TEXTURE1/PNAMES merging&#x0a;and resource deduplication.&#x0a;&#x0a;Structure: CommunityWadCompiler.Core library + Avalonia UI.</sys:String>
  <sys:String x:Key="Dialog.PickBaseWad">Select base WAD (IWAD)</sys:String>
  <sys:String x:Key="Dialog.PickWads">Select WADs</sys:String>
  <sys:String x:Key="Dialog.PickExternalMusic">Select external music file</sys:String>
  <sys:String x:Key="Dialog.MusicFilesFilter">Music files</sys:String>

  <!-- ===== Log / VM messages ===== -->
  <sys:String x:Key="Log.SlotCleared">[INFO] Slot {0} cleared.</sys:String>
  <sys:String x:Key="Log.MapReplaced">[INFO] '{0}' from '{1}' replaced the map of slot {2}</sys:String>
  <sys:String x:Key="Log.MapAssigned">[INFO] '{0}' from '{1}' → slot {2}</sys:String>
  <sys:String x:Key="Log.MapsByAuthorRemoved">[INFO] Maps by author '{0}' removed from the sheet.</sys:String>
  <sys:String x:Key="Log.MusicRenamed">[INFO] Music renamed due to duplicate name:</sys:String>
  <sys:String x:Key="Log.MusicRenamedItem">'{0}' from '{1}' → '{2}'</sys:String>
  <sys:String x:Key="Log.ProjectSaved">[INFO] Project saved to {0}</sys:String>
  <sys:String x:Key="Log.ProjectReadError">[ERROR] Could not read the project {0}</sys:String>
  <sys:String x:Key="Log.ProjectLoaded">[INFO] Project loaded from {0}</sys:String>
  <sys:String x:Key="Log.NeedInputWad">[ERROR] Add at least one input WAD.</sys:String>
  <sys:String x:Key="Log.NeedOutputPath">[ERROR] Set an output path.</sys:String>
  <sys:String x:Key="Log.NoSlot">[ERROR] The map '{0}' from '{1}' has no final slot.</sys:String>
  <sys:String x:Key="Log.Compiling">── Compiling ───────────────────────────────</sys:String>
  <sys:String x:Key="Log.NoSourcePort">[ERROR] No source port selected. Pick one in Project Settings, or add ports in Configuration → Source ports.</sys:String>
  <sys:String x:Key="Log.SourcePortMissing">[ERROR] Source port executable not found: {0}</sys:String>
  <sys:String x:Key="Log.SourcePortLaunched">[INFO] Launched {0} (PID {1}) with the compiled WAD.</sys:String>

  <!-- ===== Merge console messages (CoreMessages) ===== -->
  <sys:String x:Key="Merge.OpenBaseWad">Opening base WAD...</sys:String>
  <sys:String x:Key="Merge.NoBaseWad">  (no base WAD)</sys:String>
  <sys:String x:Key="Merge.OpenInputs">Opening input WADs...</sys:String>
  <sys:String x:Key="Merge.OpenResources">Opening resource WADs...</sys:String>
  <sys:String x:Key="Merge.NoResourceWad">  (no resource WAD)</sys:String>
  <sys:String x:Key="Merge.ScanMusic">Scanning music lumps (MUS/MIDI)...</sys:String>
  <sys:String x:Key="Merge.MusicFound">  - {0} music lump(s) detected.</sys:String>
  <sys:String x:Key="Merge.DetectMaps">Detecting maps...</sys:String>
  <sys:String x:Key="Merge.AnalyzeUsage">Analyzing textures/flats used by the maps...</sys:String>
  <sys:String x:Key="Merge.UsageFound">  - {0} wall textures and {1} flats detected.</sys:String>
  <sys:String x:Key="Merge.MergeTextures">Merging textures (PNAMES/TEXTURE1/TEXTURE2)...</sys:String>
  <sys:String x:Key="Merge.ExcludedTextures">  {0} texture(s) excluded as unused.</sys:String>
  <sys:String x:Key="Merge.Assemble">Assembling output WAD...</sys:String>
  <sys:String x:Key="Merge.CopyingMap">  Copying {0} -> {1}</sys:String>
  <sys:String x:Key="Merge.MapNoSlot">Map '{0}' from '{1}' has no slot assigned; it is skipped.</sys:String>
  <sys:String x:Key="Merge.DuplicateSlot">Two maps were assigned to slot '{0}'. Check the assignments.</sys:String>
  <sys:String x:Key="Merge.MapInfoGenerated">MAPINFO generated for {0} map(s).</sys:String>
  <sys:String x:Key="Merge.AnimdefsGenerated">ANIMDEFS lump generated for {0} numbered animation(s).</sys:String>
  <sys:String x:Key="Merge.AnimatedLumpGenerated">ANIMATED lump generated for {0} numbered animation(s).</sys:String>
  <sys:String x:Key="Merge.SwitchesLumpGenerated">SWITCHES lump generated for {0} switch(es).</sys:String>
  <sys:String x:Key="Merge.MapInfoSkipped">Existing MAPINFO/ZMAPINFO lumps from the WADs were skipped; the generated MAPINFO with the names is used.</sys:String>
  <sys:String x:Key="Merge.ZdoomTexturesDropped">ZDoom 'TEXTURES' lumps detected; merging them is not implemented yet and they were dropped.</sys:String>
  <sys:String x:Key="Merge.MusicRenamed">Music '{0}' (from '{1}') renamed to '{2}'.</sys:String>
  <sys:String x:Key="Merge.MusicNotInWads">Music '{0}' was not found in the loaded WADs; MAPINFO still references it (it must exist in the IWAD or be identical in the engine).</sys:String>
  <sys:String x:Key="Merge.IntermissionMusicAdded">Intermission music '{0}' added from '{1}'.</sys:String>
  <sys:String x:Key="Merge.IntermissionMusicMissing">Intermission music '{0}' was not found in the loaded WADs; MAPINFO still references it (it must exist in the IWAD or be identical in the engine).</sys:String>
  <sys:String x:Key="Merge.ExternalMusicAdded">External music '{0}' copied from '{1}'.</sys:String>
  <sys:String x:Key="Merge.ExternalMusicMissing">External music '{0}': file not found '{1}'.</sys:String>
  <sys:String x:Key="Merge.ExternalMusicUnsupported">External music '{0}': extension '{1}' is not supported.</sys:String>
  <sys:String x:Key="Merge.SkyMissing">Sky texture '{0}' was not found in the resource WADs; MAPINFO still references it.</sys:String>
  <sys:String x:Key="Merge.TextureWithoutPnames">{0}: contains TEXTUREx without PNAMES; attempting to resolve patches by name.</sys:String>
  <sys:String x:Key="Merge.TextureDuplicate">Texture '{0}' duplicated; the first definition is kept.</sys:String>
  <sys:String x:Key="Merge.PatchIndexOutOfRange">Texture '{0}': patch index {1} out of range.</sys:String>
  <sys:String x:Key="Merge.TextureLumpTooShort">Lump empty or too short to be a TEXTUREx.</sys:String>
  <sys:String x:Key="Merge.InvalidTextureCount">Invalid texture count ({0}).</sys:String>
  <sys:String x:Key="Merge.MalformedTexture">Texture #{0} (offset {1}) malformed; skipped.</sys:String>
  <sys:String x:Key="Merge.WadReadFailed">Could not read '{0}': {1}</sys:String>
  <sys:String x:Key="Merge.WadTooSmall">The file is too small to be a WAD.</sys:String>
  <sys:String x:Key="Merge.UnknownHeader">Unknown WAD header '{0}' (expected IWAD or PWAD).</sys:String>
  <sys:String x:Key="Merge.InvalidLumpDirectory">Invalid lump directory or out of range.</sys:String>
  <sys:String x:Key="Merge.LumpOutOfBounds">Lump '{0}' points outside the file.</sys:String>

  <!-- ===== MAPINFO header/notes comments (MapInfo) ===== -->
  <sys:String x:Key="MapInfo.HeaderLine">// MAPINFO auto-generated by Community Wad Compiler</sys:String>
  <sys:String x:Key="MapInfo.Project">// Project: {0}</sys:String>
  <sys:String x:Key="MapInfo.Version">// Version: {0}</sys:String>
  <sys:String x:Key="MapInfo.Compiled">// Compiled: {0}</sys:String>
  <sys:String x:Key="MapInfo.Author">// Author: {0}</sys:String>
  <sys:String x:Key="MapInfo.Status">// Status: {0}</sys:String>
  <sys:String x:Key="MapInfo.LastModified">// Last modified: {0}</sys:String>

  <!-- ===== Compile report (Report) ===== -->
  <sys:String x:Key="Report.Success">BUILD OK ({0}s)</sys:String>
  <sys:String x:Key="Report.Failed">BUILD FAILED</sys:String>
  <sys:String x:Key="Report.Output">  Output: {0} ({1} bytes)</sys:String>
  <sys:String x:Key="Report.Maps">  Maps: {0}</sys:String>
  <sys:String x:Key="Report.Lumps">  Lumps copied: {0} | Duplicates skipped: {1}</sys:String>
  <sys:String x:Key="Report.Patches">  Patches: {0} | Textures: {1} | Duplicate textures skipped: {2}</sys:String>
  <sys:String x:Key="Report.TexturesExcluded">  Unused textures excluded: {0}</sys:String>
  <sys:String x:Key="Report.Flats">  Flats copied from resource WAD: {0}</sys:String>
  <sys:String x:Key="Report.Music">  Music lumps copied: {0}</sys:String>
  <sys:String x:Key="Log.ReportError">[ERROR] {0}</sys:String>
  <sys:String x:Key="Log.ReportWarning">[WARNING] {0}</sys:String>
  <sys:String x:Key="Log.ReportInfo">[INFO] {0}</sys:String>

  <!-- ===== Sheet header (MapsHeader) ===== -->
  <sys:String x:Key="Header.SlotsSuffix"> · {0} slots</sys:String>
  <sys:String x:Key="Header.EmptyTitle">Maps and final slots</sys:String>
  <sys:String x:Key="Header.FilterHint">Search (slot, map, author, status...)</sys:String>
  <sys:String x:Key="Filter.All">All fields</sys:String>
  <sys:String x:Key="Filter.Slot">Slot</sys:String>
  <sys:String x:Key="Filter.Wad">WAD</sys:String>
  <sys:String x:Key="Filter.OriginalMap">Original map</sys:String>
  <sys:String x:Key="Filter.LevelName">Level name</sys:String>
  <sys:String x:Key="Filter.Status">Status</sys:String>
  <sys:String x:Key="Filter.Author">Author</sys:String>
  <sys:String x:Key="Filter.Music">Music</sys:String>
  <sys:String x:Key="Filter.Notes">Notes</sys:String>
</ResourceDictionary>
