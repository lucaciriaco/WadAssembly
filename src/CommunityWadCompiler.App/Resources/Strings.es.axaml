  <sys:String x:Key="MapInfo.Version">// Versión: {0}</sys:String>
  <sys:String x:Key="MapInfo.Compiled">// Compilado: {0}</sys:String>
  <sys:String x:Key="MapInfo.Author">// Autor: {0}</sys:String>
  <sys:String x:Key="MapInfo.Status">// Estado: {0}</sys:String>
  <sys:String x:Key="MapInfo.LastModified">// Última modificación: {0}</sys:String>

  <!-- ===== Informe de compilación (Report) ===== -->
  <sys:String x:Key="Report.Success">COMPILADO OK ({0}s)</sys:String>
  <sys:String x:Key="Report.Failed">COMPILACIÓN FALLIDA</sys:String>
  <sys:String x:Key="Report.Output">  Salida: {0} ({1} bytes)</sys:String>
  <sys:String x:Key="Report.Maps">  Mapas: {0}</sys:String>
  <sys:String x:Key="Report.Lumps">  Lumps copiados: {0} | Duplicados omitidos: {1}</sys:String>
  <sys:String x:Key="Report.Patches">  Parches: {0} | Texturas: {1} | Texturas duplicadas omitidas: {2}</sys:String>
  <sys:String x:Key="Report.TexturesExcluded">  Texturas sin uso excluidas: {0}</sys:String>
  <sys:String x:Key="Report.Flats">  Flats copiados del WAD de recursos: {0}</sys:String>
  <sys:String x:Key="Report.Music">  Lumps de música copiados: {0}</sys:String>
  <sys:String x:Key="Log.ReportError">[ERROR] {0}</sys:String>
